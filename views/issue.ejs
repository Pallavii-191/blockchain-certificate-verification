<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Certify - Issue Certificate</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f7f6; }
        .card { background: white; padding: 30px; border-radius: 8px; max-width: 600px; margin: auto; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        input[type="text"] { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background-color: #28a745; color: white; border: none; padding: 12px 20px; border-radius: 4px; cursor: pointer; width: 100%; }
        .nav { text-align: center; margin-bottom: 20px; }
        .nav a { margin: 0 10px; color: #2b3e50; text-decoration: none; font-weight: bold; }
        .success { margin-top: 20px; padding: 15px; border-left: 5px solid #28a745; background: #e9f7ef; color: #28a745; }
        .error { margin-top: 20px; padding: 15px; border-left: 5px solid #dc3545; background: #fdf2f2; color: #dc3545; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/">Verify Certificate</a> | <a href="/issue">Issue Certificate</a>
    </div>
    <div class="card">
        <h2>Issue New Certificate</h2>
        <form action="/issue" method="POST">
            <label>Student Address (Ganache):</label>
            <input type="text" name="studentAddress" placeholder="0x..." required />
            
            <label>Student Name:</label>
            <input type="text" name="studentName" required />
            
            <label>Course Name:</label>
            <input type="text" name="courseName" required />
            
            <label>Grade / Marks:</label>
            <input type="text" name="grade" required />
            
            <button type="submit">Issue Certificate</button>
        </form>

        <% if (message) { %>
            <div class="success"><%= message %></div>
        <% } %>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
    </div>
</body>
</html>
